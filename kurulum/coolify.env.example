# İç ağ ayarı. :8000 Coolify paneli; :8765 fatura uygulamasıdır.
FATURA_PUBLIC_URL=http://10.21.41.219:8765
FATURA_ALLOW_PRIVATE_HTTP=true
FATURA_ADMIN_USER=yonetici
# En az 16 karakter. Gerçek parolayı sadece Coolify runtime secret alanına yazın.
FATURA_ADMIN_PASSWORD=
FATURA_DATA_DIR=/data
PORT=8765
# HTTPS alan adı kullanıldığında FATURA_ALLOW_PRIVATE_HTTP=false seçin.

# --- Supabase modu (tanımlı değilse uygulama SQLite ile çalışır) ---
# Değerleri yalnızca Coolify runtime secret alanına yazın. Ayrıntı: docs/veritabani.md
# FATURA_DATABASE_URL=postgresql://fatura_backend.dev_tenant:<FATURA_DB_PASSWORD>@<SUPAVISOR_HOST>:6543/postgres
# SUPABASE_URL=http://<supabase-kong-ic-adresi>:8000
# SUPABASE_SERVICE_ROLE_KEY=
# FATURA_STORAGE_BUCKET=fatura-belgeler
# FATURA_DB_POOL_SIZE=4
# /data bağlı kalmalı: Supabase modunda PDF ve önizleme önbelleği olarak kullanılır.
